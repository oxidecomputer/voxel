export BUILD_ROOT=/home/nicolas/workspace/voxel-builds
export FALCON_DATASET=tank/falcon
export VOXEL_BUILD_CP=/home/nicolas/workspace/662/voxel/voxel-image/build-cp.sh
# locally built sidecar-lite (rid-keyed tables), pre-seeded in voxel-image/.sidecar-lite/
export SIDECAR_LITE_REV=local-poc662
